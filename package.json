{
  "name": "slash-md-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Slash MD monorepo — VS Code extension + Electron desktop + shared packages",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w slash-md",
    "watch": "npm run watch -w slash-md",
    "debug": "npm run build && cursor --extensionDevelopmentPath=\"${PWD}/apps/vscode\"",
    "package": "npm run package -w slash-md",
    "package:vsix": "npm run package:vsix -w slash-md",
    "test:roundtrip": "node test/build.mjs && node test/boot.mjs",
    "test": "npm run test:roundtrip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps/desktop packages test && tsc --noEmit",
    "desktop:dev": "npm run dev -w @slash-md/desktop",
    "desktop:build": "npm run build -w @slash-md/desktop",
    "desktop:pack": "npm run pack -w @slash-md/desktop",
    "desktop:lint": "npm run lint -w @slash-md/desktop",
    "desktop:typecheck": "npm run typecheck -w @slash-md/desktop",
    "desktop:web:build": "npm run web:build -w @slash-md/desktop",
    "slash": "node apps/desktop/bin/slash",
    "reader:build": "npm run build -w @slash-md/reader",
    "reader:site": "node apps/reader/dist/build-site.mjs",
    "site:build": "npm run desktop:web:build && npm run reader:build && SITE_ROOT=${SITE_ROOT:-apps/reader/fixtures/wiki} SITE_BASE=${SITE_BASE:-/} SITE_OUT=${SITE_OUT:-$PWD/.tmp/site} WEB_ASSETS_DIR=${WEB_ASSETS_DIR:-$PWD/apps/desktop/dist-web} node apps/reader/dist/build-site.mjs",
    "site:preview": "npm run site:build && npx --yes serve -l ${PORT:-4199} ${SITE_OUT:-$PWD/.tmp/site}"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0"
  }
}
