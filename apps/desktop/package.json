{
  "name": "@slash-md/desktop",
  "version": "0.1.0",
  "private": true,
  "productName": "SlashMD",
  "description": "Local-first wiki for product docs",
  "author": "Saul Moreyra",
  "license": "MIT",
  "homepage": "https://github.com/SaulMoreyra/slash-md",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaulMoreyra/slash-md.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node ./scripts/brand-electron.mjs && env -u ELECTRON_RUN_AS_NODE vite",
    "build": "vite build",
    "start": "node ./scripts/brand-electron.mjs && electron .",
    "postinstall": "node ./scripts/brand-electron.mjs",
    "pack": "npm run build && electron-builder --mac --arm64",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src electron shared && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "bin": {
    "slash": "./bin/slash"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@slash-md/agents": "0.1.0",
    "@slash-md/core": "0.1.0",
    "@slash-md/github": "0.1.0",
    "@slash-md/ui": "0.1.0",
    "i18next": "^26.4.0",
    "lucide-react": "^1.34.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "35.7.5",
    "electron-builder": "^26.0.12",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^6.3.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "app.slashmd.desktop",
    "productName": "SlashMD",
    "electronVersion": "35.7.5",
    "copyright": "Copyright © 2026 Saul Moreyra",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "build/icon.icns",
      "package.json"
    ],
    "extraMetadata": {
      "name": "slashmd",
      "main": "dist-electron/main.js"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "darkModeSupport": true,
      "extendInfo": {
        "CFBundleName": "SlashMD",
        "CFBundleDisplayName": "SlashMD"
      },
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ]
    },
    "dmg": {
      "title": "SlashMD"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": ["AppImage"]
    },
    "win": {
      "icon": "build/icon.png",
      "target": ["nsis"]
    }
  }
}
