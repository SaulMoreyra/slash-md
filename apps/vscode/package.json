{
  "name": "slash-md",
  "displayName": "Slash MD",
  "description": "Notion-like WYSIWYG Markdown editor. Open any .md file, write with slash commands, covers, and icons; autosave writes the real file.",
  "version": "0.1.0",
  "publisher": "saulmoreyra",
  "license": "MIT",
  "icon": "media/slash.png",
  "galleryBanner": {
    "color": "#F7F7F5",
    "theme": "light"
  },
  "homepage": "https://github.com/SaulMoreyra/slash-md#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaulMoreyra/slash-md.git"
  },
  "bugs": {
    "url": "https://github.com/SaulMoreyra/slash-md/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "notion",
    "editor",
    "mermaid",
    "docs"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "slash-md.openMarkdown",
        "title": "Open with Slash MD",
        "category": "Slash MD",
        "icon": "$(markdown)"
      },
      {
        "command": "slash-md.useAsDefaultMarkdown",
        "title": "Use as default Markdown editor",
        "category": "Slash MD"
      },
      {
        "command": "slash-md.stopUsingAsDefaultMarkdown",
        "title": "Stop using as default Markdown editor",
        "category": "Slash MD"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "slash-md.openMarkdown",
          "when": "resourceExtname == .md && resourceLangId == markdown",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "slash-md.openMarkdown",
          "when": "resourceExtname == .md && resourceLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Slash MD",
      "properties": {
        "slash-md.useAsDefaultMarkdown": {
          "type": "boolean",
          "default": false,
          "description": "When true, *.md files open with Slash MD instead of the built-in Markdown editor."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "slash-md.editor",
        "displayName": "Slash MD",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npx @vscode/vsce@2.32.0 package --no-dependencies",
    "package:vsix": "npx @vscode/vsce@2.32.0 package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@slash-md/core": "0.1.0",
    "@slash-md/ui": "0.1.0"
  }
}
